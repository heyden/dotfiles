{
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/*.meta": true
    },
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/*.meta": true
    },
    "editor.bracketPairColorization.enabled": true,

    "telemetry.telemetryLevel": "off",
    "codeQL.telemetry.enableTelemetry": false,
    "explorer.confirmDragAndDrop": false,
    "editor.minimap.enabled": false,
    "workbench.startupEditor": "none",
    "workbench.editorAssociations": {
        "*.lock": "default"
    },
    "breadcrumbs.enabled": true,
    "[rust]": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll": "always",
            "source.organizeImports": "always"
        }
    },
    "[go]": {
        "editor.insertSpaces": false,
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "always"
        }
    },
    "gopls": {
        "ui.completion.usePlaceholders": true,
        "ui.diagnostic.staticcheck": true,
        "ui.semanticTokens": true,
    },
    "go.formatTool": "goimports",
    "go.toolsManagement.autoUpdate": true,
    "[prisma]": {
        "editor.formatOnSave": true
    },

    "[javascript]": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "always",
            "source.organizeImports": "always"
        },
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescript]": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "always",
            "source.organizeImports": "always"
        },
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "js/ts.updateImportsOnFileMove.enabled": "never",
    "[dart]": {
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.rulers": [
            80
        ],
        "editor.selectionHighlight": false,
        "editor.suggest.snippetsPreventQuickSuggestions": false,
        "editor.suggestSelection": "first",
        "editor.tabCompletion": "onlySnippets",
        "editor.wordBasedSuggestions": "currentDocument"
    },
    "python.languageServer": "Pylance",
    "[java]": {
        "editor.suggest.snippetsPreventQuickSuggestions": false,
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "always",
        }
    },
    "java.codeGeneration.generateComments": true,
    "java.import.generatesMetadataFilesAtProjectRoot": true,
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx1G -Xms100m -javaagent:\"c:\\Users\\kris\\.vscode\\extensions\\gabrielbb.vscode-lombok-1.0.1\\server\\lombok.jar\"",
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "window.zoomLevel": 0,
    "workbench.browser.pageZoom": "100%",
    "editor.fontSize": 14,
    "explorer.confirmDelete": false,
}